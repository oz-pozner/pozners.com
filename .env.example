# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed. In production it is
# uploaded to the server directly over FTP - never through git (deploy.sh
# deliberately excludes it) - so credentials never touch the repo.

SITE_TITLE=Pozner Family
SITE_URL=https://pozners.com
CONTACT_EMAIL=oz@pozners.com
CONTACT_FORM_URL=https://form.fillout.com/t/REPLACE_WITH_CONTACT_FORM_ID
MEETING_FORM_URL=https://form.fillout.com/t/REPLACE_WITH_MEETING_FORM_ID

# Admin portal login (includes/config.php reads these - never hardcoded).
# Generate the hash with:
#   php -r 'echo password_hash("your-password", PASSWORD_BCRYPT), PHP_EOL;'
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# FTP credentials for scripts/deploy.sh (IONOS shared hosting).
FTP_HOST=
FTP_USERNAME=
FTP_PASSWORD=
FTP_REMOTE_PATH=/
# Optional - defaults shown:
# FTP_PORT=21
# FTP_SSL=yes
